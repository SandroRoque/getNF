# Real receipts: personal/financial data and large files. Kept local only.
# Small, sanitized parser fixtures (tools/make-nfce-fixture.py) belong in android/app/src/test/fixtures instead.
/test-media/**
!/test-media/README.md

# Local credentials: the Supabase URL and keys, the database password, LM Studio's key. Never commit.
/.env.local
# The retired PocketBase server's data and credentials, still on disk in the main checkout.
/server/

# Claude Code per-machine settings
/.claude/settings.local.json

# Python bytecode
__pycache__/

# Signing keys: the upload key lives in ~/.config/getnf (tools/make-upload-key.sh), never in the repo.
*.jks
*.keystore
upload-key.properties

# Built web pages carry the project URL and key (tools/build-web.py).
/web/dist/
/web/.wrangler/
