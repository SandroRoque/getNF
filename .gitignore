# Real receipts: personal/financial data and large files. Kept local only.
# Small, sanitized parser fixtures belong in android/ or server/ test dirs instead.
/test-media/**
!/test-media/README.md

# PocketBase runtime data and local credentials
/server/pb_data/
/server/.env.local
/server/.env

# Claude Code per-machine settings
/.claude/settings.local.json

# Python bytecode
__pycache__/

# Signing keys: the upload key lives in ~/.config/getnf (tools/make-upload-key.sh), never in the repo.
*.jks
*.keystore
upload-key.properties

# Built web pages carry the project URL and key (tools/build-web.py).
/web/dist/
/web/.wrangler/
